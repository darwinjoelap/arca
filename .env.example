# Copiar a .env (que NO se sube al repositorio) y rellenar.
# En Railway estas mismas variables se cargan en el panel del servicio.

DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# PostgreSQL local. En Railway, DATABASE_URL la entrega el plugin de Postgres.
DATABASE_URL=postgresql://postgres:clave@127.0.0.1:5432/arca

TIME_ZONE=America/Caracas
LANGUAGE_CODE=es-ve
